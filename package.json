{
  "name": "relanox",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity error .",
    "format": "oxfmt --write .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "prepare": "node scripts/install-hooks.mts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.11.2"
}
