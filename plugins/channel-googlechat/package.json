{
  "name": "@relanox/channel-googlechat",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@googleapis/chat": "51.2.0",
    "@relanox/channel-media": "workspace:*",
    "@relanox/markdown": "workspace:*",
    "@relanox/sdk": "workspace:*",
    "@relanox/transport": "workspace:*",
    "google-auth-library": "11.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@relanox/core": "workspace:*",
    "@relanox/storage-sqlite": "workspace:*",
    "jose": "6.2.12"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "relanox": {
    "kind": "channel",
    "id": "googlechat",
    "sdkMajor": 1,
    "entry": "./dist/plugin.js"
  }
