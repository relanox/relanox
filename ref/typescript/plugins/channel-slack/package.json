{
  "name": "@relanox/channel-slack",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@relanox/channel-media": "workspace:*",
    "@relanox/markdown": "workspace:*",
    "@relanox/sdk": "workspace:*",
    "@relanox/transport": "workspace:*",
    "@slack/socket-mode": "3.1.0",
    "@slack/types": "3.2.0",
    "@slack/web-api": "8.2.0",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "relanox": {
    "kind": "channel",
    "id": "slack",
    "sdkMajor": 1,
    "entry": "./dist/plugin.js"
  }
