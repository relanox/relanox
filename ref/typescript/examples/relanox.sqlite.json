{
  "publicUrl": "https://relay.example.com",
  "relay": {
    "accounts": [
      {
        "id": "telegram-main",
        "channel": "telegram",
        "allowedSenders": ["12345678"],
        "config": {
          "botToken": {
            "env": "TELEGRAM_BOT_TOKEN"
          },
          "webhookSecret": {
            "env": "TELEGRAM_WEBHOOK_SECRET"
          }
        }
      }
    ],
    "endpoints": [
      {
        "id": "agent-1",
        "agent": "grok",
        "config": {
          "mcp": {
            "token": {
              "env": "RELANOX_AGENT_1_MCP_TOKEN"
            },
            "auth": "path"
          },
          "routineUrl": {
            "env": "RELANOX_AGENT_1_ROUTINE_URL"
          },
          "routineAuthorization": {
            "env": "RELANOX_AGENT_1_ROUTINE_AUTHORIZATION"
          }
        }
      }
    ],
    "bindings": [
      {
        "accountId": "telegram-main",
        "chatId": "12345678",
        "endpointId": "agent-1"
      }
    ],
    "storage": {
      "plugin": "sqlite",
      "config": {
        "filename": "relanox.sqlite"
      }
    }
  }
}
