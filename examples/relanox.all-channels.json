{
  "publicUrl": "https://relay.example.com",
  "relay": {
    "accounts": [
      {
        "id": "telegram-main",
        "channel": "telegram",
        "allowedSenders": ["123456789"],
        "config": {
          "botToken": {
            "env": "TELEGRAM_BOT_TOKEN"
          },
          "webhookSecret": {
            "env": "TELEGRAM_WEBHOOK_SECRET"
          }
        }
      },
      {
        "id": "discord-main",
        "channel": "discord",
        "allowedSenders": ["123456789012345678"],
        "config": {
          "botToken": {
            "env": "DISCORD_BOT_TOKEN"
          }
        }
      },
      {
        "id": "slack-main",
        "channel": "slack",
        "allowedSenders": ["U123ABC"],
        "config": {
          "botToken": {
            "env": "SLACK_BOT_TOKEN"
          },
          "signingSecret": {
            "env": "SLACK_SIGNING_SECRET"
          },
          "appId": "A123ABC"
        }
      },
      {
        "id": "feishu-main",
        "channel": "feishu",
        "allowedSenders": ["ou_example_user"],
        "config": {
          "appId": "cli_example",
          "appSecret": {
            "env": "FEISHU_APP_SECRET"
          },
          "verificationToken": {
            "env": "FEISHU_VERIFICATION_TOKEN"
          },
          "encryptKey": {
            "env": "FEISHU_ENCRYPT_KEY"
          },
          "tenantKey": "example-tenant",
          "domain": "feishu"
        }
      },
      {
        "id": "wecom-main",
        "channel": "wecom",
        "allowedSenders": ["staff-userid"],
        "config": {
          "botId": "intelligent-robot-id",
          "secret": {
            "env": "WECOM_BOT_SECRET"
          }
        }
      },
      {
        "id": "dingtalk-main",
        "channel": "dingtalk",
        "allowedSenders": ["$:LWCP_v1:opaque-platform-sender-id"],
        "config": {
          "clientId": "application-client-id",
          "clientSecret": {
            "env": "DINGTALK_APP_SECRET"
          },
          "robotCode": "application-robot-code"
        }
      },
      {
        "id": "qq-main",
        "channel": "qq",
        "allowedSenders": ["user-openid", "group-member-openid"],
        "config": {
          "appId": "robot-app-id",
          "clientSecret": {
            "env": "QQ_CLIENT_SECRET"
          },
          "allowProactive": false
        }
      },
      {
        "id": "msteams-main",
        "config": {
          "appId": "microsoft_application_id",
          "botId": "28:bot_activity_recipient_id",
          "tenantId": "allowed_teams_tenant_id",
          "appSecret": {
            "env": "TEAMS_APP_SECRET"
          },
          "trustedServiceOrigins": ["https://smba.trafficmanager.net"]
        },
        "channel": "msteams",
        "allowedSenders": ["29:teams-user-id"]
      },
      {
        "id": "whatsapp-main",
        "config": {
          "phoneNumberId": "your_phone_number_id",
          "businessAccountId": "your_whatsapp_business_account_id",
          "appSecret": {
            "env": "WHATSAPP_APP_SECRET"
          },
          "verifyToken": {
            "env": "WHATSAPP_VERIFY_TOKEN"
          },
          "accessToken": {
            "env": "WHATSAPP_ACCESS_TOKEN"
          }
        },
        "channel": "whatsapp",
        "allowedSenders": ["15551234567"]
      },
      {
        "id": "matrix-main",
        "config": {
          "homeserver": "https://matrix.example.com",
          "accessToken": {
            "env": "MATRIX_ACCESS_TOKEN"
          }
        },
        "channel": "matrix",
        "allowedSenders": ["@alice:example.com"]
      },
      {
        "id": "googlechat-main",
        "config": {
          "serviceAccount": {
            "env": "GOOGLE_CHAT_SERVICE_ACCOUNT_JSON"
          }
        },
        "channel": "googlechat",
        "allowedSenders": ["users/123456789"]
      },
      {
        "id": "line-main",
        "config": {
          "channelSecret": {
            "env": "LINE_CHANNEL_SECRET"
          },
          "accessToken": {
            "env": "LINE_ACCESS_TOKEN"
          }
        },
        "channel": "line",
        "allowedSenders": ["U_example_user"]
      },
      {
        "id": "mattermost-main",
        "config": {
          "serverUrl": "https://mattermost.example.com",
          "token": {
            "env": "MATTERMOST_TOKEN"
          }
        },
        "channel": "mattermost",
        "allowedSenders": ["dedicated_sender_id"]
      },
      {
        "id": "signal-main",
        "config": {
          "serviceUrl": "https://signal-bridge.example.com",
          "account": "+15551234567",
          "authorization": {
            "env": "SIGNAL_BRIDGE_AUTHORIZATION"
          }
        },
        "channel": "signal",
        "allowedSenders": ["11111111-1111-4111-8111-111111111111"]
      },
      {
        "id": "irc-main",
        "config": {
          "server": "irc.example.com",
          "port": 6697,
          "tls": true,
          "nick": "relanox",
          "sasl": {
            "username": "relanox",
            "password": {
              "env": "IRC_SASL_PASSWORD"
            }
          }
        },
        "channel": "irc",
        "allowedSenders": ["account:alice"]
      }
    ],
    "endpoints": [
      {
        "id": "agent-1",
        "agent": "dot",
        "config": {
          "mcp": {
            "token": {
              "env": "RELANOX_AGENT_1_MCP_TOKEN"
            },
            "auth": "oauth"
          }
        }
      },
      {
        "id": "agent-2",
        "agent": "grok",
        "config": {
          "mcp": {
            "token": {
              "env": "RELANOX_AGENT_2_MCP_TOKEN"
            },
            "auth": "path"
          },
          "routineUrl": {
            "env": "RELANOX_AGENT_2_ROUTINE_URL"
          },
          "routineAuthorization": {
            "env": "RELANOX_AGENT_2_ROUTINE_AUTHORIZATION"
          }
        }
      }
    ],
    "bindings": [
      {
        "accountId": "telegram-main",
        "chatId": "123456789",
        "endpointId": "agent-2"
      },
      {
        "accountId": "discord-main",
        "chatId": "112233445566778899",
        "endpointId": "agent-1"
      },
      {
        "accountId": "slack-main",
        "chatId": "C123ABC",
        "endpointId": "agent-2",
        "threadId": "1710000000.000001"
      },
      {
        "accountId": "feishu-main",
        "chatId": "oc_example_chat",
        "endpointId": "agent-2"
      },
      {
        "accountId": "wecom-main",
        "chatId": "staff-userid",
        "endpointId": "agent-2"
      },
      {
        "accountId": "dingtalk-main",
        "chatId": "staff-user-id",
        "endpointId": "agent-2"
      },
      {
        "accountId": "qq-main",
        "chatId": "user-openid",
        "endpointId": "agent-2"
      },
      {
        "accountId": "msteams-main",
        "chatId": "teams-conversation-id",
        "endpointId": "agent-2"
      },
      {
        "accountId": "whatsapp-main",
        "chatId": "15551234567",
        "endpointId": "agent-2"
      },
      {
        "accountId": "matrix-main",
        "chatId": "!support:example.com",
        "endpointId": "agent-1"
      },
      {
        "accountId": "googlechat-main",
        "chatId": "spaces/AAAAExample",
        "endpointId": "agent-2",
        "threadId": "spaces/AAAAExample/threads/BBBBExample"
      },
      {
        "accountId": "line-main",
        "chatId": "G_example_group",
        "endpointId": "agent-2"
      },
      {
        "accountId": "mattermost-main",
        "chatId": "dedicated_channel_id",
        "endpointId": "agent-2"
      },
      {
        "accountId": "signal-main",
        "chatId": "direct:11111111-1111-4111-8111-111111111111",
        "endpointId": "agent-2"
      },
      {
        "accountId": "irc-main",
        "chatId": "#support",
        "endpointId": "agent-1"
      }
    ],
    "storage": {
      "plugin": "sqlite",
      "config": {
        "filename": "relanox-all.sqlite"
      }
    }
  }
}
