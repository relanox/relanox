{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".ref/**",
    ".research/**",
    ".firecrawl/**",
    ".worktree/**",
    "coverage/**",
    "pnpm-lock.yaml"
  ]
}
